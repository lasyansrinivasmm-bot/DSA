class Solution {

    public String lexPalindromicPermutation(String s, String target) {

        int n = s.length();
        int[] freq = new int[26];

      Lexicography Smallest palindrome
        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        
        int odd = 0;
        char middle = 0;

        for (int i = 0; i < 26; i++) {
            if (freq[i] % 2 == 1) {
                odd++;
                middle = (char) ('a' + i);
            }
        }

        if (odd > 1) {
            return "";
        }

        int halfSize = n / 2;
        char[] half = new char[halfSize];

        int index = 0;

        for (int i = 0; i < 26; i++) {
            for (int j = 0; j < freq[i] / 2; j++) {
                half[index++] = (char) ('a' + i);
            }
        }

        
        String answer = buildPalindrome(half, middle);

        if (answer.compareTo(target) > 0) {
            return answer;
        }

       
        while (nextPermutation(half)) {

            answer = buildPalindrome(half, middle);

            if (answer.compareTo(target) > 0) {
                return answer;
            }
        }

        return "";
    }

    private String buildPalindrome(char[] half, char middle) {

        StringBuilder sb = new StringBuilder();

       
        for (char c : half) {
            sb.append(c);
        }

       
        if (middle != 0) {
            sb.append(middle);
        }

       1; i >= 0; i--) {
            sb.append(half[i]);
        }

        return sb.toString();
    }

    private boolean nextPermutation(char[] arr) {

        int i = arr.length - 2;

      
        while (i >= 0 && arr[i] >= arr[i + 1]) {
            i--;
        }

        if (i < 0) {
            return false;
        }

        // Find element greater than arr[i]
        int j = arr.length - 1;

        while (arr[j] <= arr[i]) {
            j--;
        }

       
        char temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;

        int left = i + 1;
        int right = arr.length - 1;

        while (left < right) {
            temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;

            left++;
            right--;
        }

        return true;
    }
}
