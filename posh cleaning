import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();

        while (T-- > 0) {
            int n = sc.nextInt();
            int[] a = new int[n];

            for (int i = 0; i < n; i++) a[i] = sc.nextInt();

            int ans = 0;

            for (int i = 0; i < n; i++) {
                ans = Math.max(ans, a[i]);
                for (int j = i + 1; j < n; j++)
                    if (a[i] <= a[j])
                        ans = Math.max(ans, a[i] + a[j]);
            }

            System.out.println(ans);
        }
    }
}
